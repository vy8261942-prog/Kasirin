& "C:\src\flutter\bin\flutter.bat" pub get
& "C:\src\flutter\bin\flutter.bat" devices
& "C:\src\flutter\bin\flutter.bat" run
& "C:\src\flutter\bin\flutter.bat" doctor -v
& "C:\src\flutter\bin\flutter.bat" build apk --debug -v *> build_error.txt
Select-String -Path .\build_error.txt `
  -Pattern "What went wrong:|Execution failed|Could not resolve|Could not find|A problem occurred|Exception|error:" `
  -Context 2,5 |
  Select-Object -First 40

  & "C:\src\flutter\bin\flutter.bat" analyze